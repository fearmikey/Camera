<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour silhouette for Android 13+ themed icons: the system tints it
     with the wallpaper palette, so only alpha matters. The lens is cut out
     (evenOdd) so it stays recognisable. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2">
        <!-- Top bump -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M9,3h6c1.1,0 2,0.9 2,2v1H7V5C7,3.9 7.9,3 9,3Z" />
        <!-- Body with the lens ring cut out -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M20,6H4C2.9,6 2,6.9 2,8v10C2,19.1 2.9,20 4,20h16c1.1,0 2,-0.9 2,-2V8C22,6.9 21.1,6 20,6Z M12,13m-4.5,0a4.5,4.5 0,1 0,9 0a4.5,4.5 0,1 0,-9 0Z" />
        <!-- Inner lens -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,13m-3,0a3,3 0,1 1,6 0a3,3 0,1 1,-6 0" />
    </group>
</vector>
